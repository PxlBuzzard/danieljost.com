{
  "name": "danieljost-com",
  "private": true,
  "version": "1.0.0",
  "description": "Daniel Jost's portfolio, built with Astro",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "astro check && biome ci .",
    "deploy": "npm run build && wrangler deploy",
    "images:convert": "node scripts/convert-images.mjs"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.6.2",
    "sharp": "^0.35.5",
    "typescript": "6.0.3",
    "wrangler": "^4.156.0"
  }
}
