---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: "lazy" | "eager";
  fetchPriority?: "high" | "low" | "auto";
  class?: string;
}

const { src, alt, width, height, loading, fetchPriority, class: className } = Astro.props;
const modernImagePath = (extension: string) => src.replace(/\.(png|jpe?g)$/i, `.${extension}`);
---

<picture>
  <source srcset={modernImagePath("avif")} type="image/avif" />
  <source srcset={modernImagePath("webp")} type="image/webp" />
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchPriority}
    class={className}
  />
</picture>
