---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: "lazy" | "eager";
  fetchPriority?: "high" | "low" | "auto";
  class?: string;
  fluid?: boolean;
}

const { src, alt, width, height, loading, fetchPriority, class: className, fluid = false } = Astro.props;
const modernImagePath = (extension: string) => src.replace(/\.(png|jpe?g)$/i, `.${extension}`);
---

<picture class:list={[className, { "responsive-image": fluid }]}>
  <source srcset={modernImagePath("avif")} type="image/avif" />
  <source srcset={modernImagePath("webp")} type="image/webp" />
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchPriority}
    class={className}
  />
</picture>

<style>
  .responsive-image {
    display: block;
    width: 100%;
  }

  .responsive-image > img {
    display: block;
    width: 100%;
    max-width: 100%;
    object-fit: cover;
  }
</style>
